{
  "appName": "AutoForge Market",
  "packageName": "com.appforge.cars",
  "version": "1.0.0",
  "versionCode": 1,
  "description": "أريد تطبيقاً لبيع السيارات المستعملة يحتوي على تسجيل المستخدمين، إضافة السيارات، الصور، السعر، الموقع، البحث، الفلاتر، المفضلة، المحادثات، الإشعارات، الدفع عبر Stripe وPayPal، ولوحة تحكم للإدارة.",
  "category": "Automotive Marketplace",
  "theme": {
    "primaryColor": "#2563EB",
    "secondaryColor": "#1D4ED8",
    "accentColor": "#10B981",
    "backgroundColor": "#F8FAFC",
    "darkBackgroundColor": "#0F172A",
    "fontFamily": "Roboto"
  },
  "backend": {
    "type": "php",
    "phpVersion": "8.2+",
    "databaseType": "mysql",
    "authType": "jwt",
    "uploadStorage": "local_storage",
    "cpanelCompatible": true
  },
  "payments": {
    "enabled": true,
    "gateways": [
      "stripe",
      "paypal",
      "manual"
    ],
    "currency": "USD"
  },
  "modules": {
    "auth": true,
    "catalog": true,
    "cars": true,
    "favorites": true,
    "messaging": true,
    "payments": true,
    "reviews": true,
    "notifications": true,
    "coupons": false,
    "adminPanel": true,
    "pages": true
  },
